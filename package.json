{
  "name": "cards-no-cards",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Spanish vocabulary-retention PWA (Cards No Cards)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate-cli.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "drizzle-orm": "^0.44.6",
    "next": "^15.5.28",
    "openai": "^4.104.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.36.0",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "drizzle-kit": "^0.31.5",
    "eslint": "9.36.0",
    "eslint-config-next": "^15.5.28",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.7"
  }
}

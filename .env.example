# Cards No Cards — environment configuration (names and placeholders only)
# Copy this file to .env.local for development. NEVER commit real secrets.

# --- Runtime ---
# One of: development | test | production
NODE_ENV=development

# --- Application ---
# Public base URL of the app (used for links, callbacks, etc.)
APP_BASE_URL=http://localhost:3000

# --- Database (SQLite) ---
# Filesystem path to the local SQLite database file.
DATABASE_URL=file:./local-data/cards.sqlite

# --- AI provider ---
# Which AI provider adapter to use. Supported: mock | openai
AI_PROVIDER=mock
# OpenAI API key (server-side only). Leave empty when AI_PROVIDER=mock.
OPENAI_API_KEY=
# Model id to request from the provider (optional; provider has a default).
AI_MODEL=
# Optional base URL for an OpenAI-compatible endpoint (optional).
AI_BASE_URL=
# Resilience tuning for real AI adapters (ignored when AI_PROVIDER=mock).
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
# Minimum spacing between AI requests in ms (0 disables rate limiting).
AI_MIN_REQUEST_INTERVAL_MS=0

# --- Authentication ---
# Which auth provider to use. Supported: dev | cognito
# `dev` resolves a local mock session (no real login) for development and
# tests. `cognito` (Amazon Cognito + Sign in with Apple) is wired up in a
# later phase.
AUTH_PROVIDER=dev
# Local development user used by the `dev` provider.
DEV_USER_ID=dev-user
DEV_USER_EMAIL=dev@example.com
DEV_USER_NAME=Local Developer

# --- Authentication (Amazon Cognito) — placeholders, wired up in a later phase ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_REGION=eu-west-1
